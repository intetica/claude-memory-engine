# Postgres-compatible DB (Supabase, neon, local pg, etc.).
# Required for memory server, workers, query.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Memory schema name. Default: claude_memory.
# Change if you want to isolate multiple Claude projects in the same DB.
MEMORY_SCHEMA="claude_memory"

# Project tag stored on every observation. Default: default.
# Use a slug per project so cross-project search stays clean.
MEMORY_PROJECT="my-project"

# MCP server name as it appears in Claude Code. Default: claude-memory.
# Tools will be exposed as mcp__<name>__search, etc.
MEMORY_SERVER_NAME="claude-memory"

# Anthropic API key — used by extractor (PostToolUse → observation) and compile (daily logs → wiki articles).
ANTHROPIC_API_KEY="sk-ant-..."

# Voyage AI key — used by embedding-worker for semantic search vectors.
# Get it at https://voyageai.com/
VOYAGE_API_KEY="pa-..."
